# Defaults for `npm run build` / `npm start` (NODE_ENV=production). Committed — no secrets here.
#
# API_URL is baked into the /api/* rewrite at build time. A build-time environment variable
# (CI / hosting provider, `docker build --build-arg`, or .env.production.local) takes precedence
# over this file.

# Backend monolith (backend/application) on Render. Client: https://biddr-frontend.onrender.com
API_URL=https://bidder-application.onrender.com
