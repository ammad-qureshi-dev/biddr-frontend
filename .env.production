# Defaults for `npm run build` / `npm start` (NODE_ENV=production). Committed — no secrets here.
#
# NEXT_PUBLIC_API_BASE_URL is inlined into the browser bundle at build time. A build-time
# environment variable (CI / hosting provider, `docker build --build-arg`, or
# .env.production.local) takes precedence over this file.

# Deployed API gateway (Render). Client: https://biddr-frontend.onrender.com
NEXT_PUBLIC_API_BASE_URL=https://bidder-api-gateway.onrender.com
