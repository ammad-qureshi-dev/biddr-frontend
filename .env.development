# Defaults for `npm run dev` (NODE_ENV=development). Committed — no secrets here.
# Override per machine in .env.development.local (git-ignored), e.g. a local gateway:
#   API_GATEWAY_URL=http://localhost:8080

# Deployed API gateway (Render). The frontend only talks to the gateway (proxied via /api/*);
# it routes to identity-auth, catalog, bidding and notification services itself.
API_GATEWAY_URL=https://bidder-api-gateway.onrender.com
