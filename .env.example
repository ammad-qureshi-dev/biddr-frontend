# Every environment variable the frontend reads. Copy what you need into .env.*.local.
#
# Load order (first match wins): process.env → .env.$NODE_ENV.local → .env.local → .env.$NODE_ENV → .env
#   npm run dev   → NODE_ENV=development → .env.development
#   npm run build → NODE_ENV=production  → .env.production

# Base URL of the backend monolith (backend/application) — no trailing slash. The browser never
# calls it directly: Next proxies /api/* to it (see next.config.ts), so the auth cookie stays
# first-party. Rewrites are fixed at build time, so changing it requires a rebuild. Required.
# (The old names API_GATEWAY_URL and NEXT_PUBLIC_API_BASE_URL are still accepted as fallbacks.)
#   local: http://localhost:8080
#   prod:  https://bidder-application.onrender.com
API_URL=http://localhost:8080
