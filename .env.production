# Defaults for `npm run build` / `npm start` (NODE_ENV=production). Committed — no secrets here.
#
# API_GATEWAY_URL is baked into the /api/* rewrite at build time. A build-time environment
# variable (CI / hosting provider, `docker build --build-arg`, or .env.production.local) takes
# precedence over this file.

# Deployed API gateway (Render). Client: https://biddr-frontend.onrender.com
API_GATEWAY_URL=https://bidder-api-gateway.onrender.com
