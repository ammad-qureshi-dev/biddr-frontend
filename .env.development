# Defaults for `npm run dev` (NODE_ENV=development). Committed — no secrets here.
# Override per machine in .env.development.local (git-ignored).

# Backend monolith (backend/application) running locally. The browser calls /api/* on this app and
# Next proxies it here; the monolith serves /identity-and-auth, /catalog and /bidding itself and
# forwards /notification to notification-service.
API_URL=http://localhost:8080
