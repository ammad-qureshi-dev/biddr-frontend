# Defaults for `npm run dev` (NODE_ENV=development). Committed — no secrets here.
# Override per machine in .env.development.local (git-ignored), e.g. a local gateway:
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Deployed API gateway (Render). The frontend only talks to the gateway; it routes to
# identity-auth, catalog, bidding and notification services itself.
NEXT_PUBLIC_API_BASE_URL=https://bidder-api-gateway.onrender.com
