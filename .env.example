# Every environment variable the frontend reads. Copy what you need into .env.*.local.
#
# Load order (first match wins): process.env → .env.$NODE_ENV.local → .env.local → .env.$NODE_ENV → .env
#   npm run dev   → NODE_ENV=development → .env.development   (committed, points at localhost:8080)
#   npm run build → NODE_ENV=production  → .env.production    (committed, no URL — supply it at build)

# Base URL of the API gateway — no trailing slash. Inlined into the browser bundle at build time,
# so changing it requires a rebuild. Required.
#   local: http://localhost:8080
#   prod:  https://api.your-domain.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
